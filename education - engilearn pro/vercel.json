{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/forgot-password.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/login-otp",
      "destination": "/login-otp.html"
    },
    {
      "source": "/otp-verification",
      "destination": "/otp-verification.html"
    },
    {
      "source": "/payment-test-report",
      "destination": "/payment-test-report.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/verify-otp",
      "destination": "/verify-otp.html"
    },
    {
      "source": "/pages/:page(about|admin|assignments|branch|contact|courses|dashboard|lecture|notifications|profile|pyq|repeated-questions|subscriber-videos|teacher)",
      "destination": "/pages/:page.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
