app.use((req, res, next) => {
    const requestId = String(req.headers["x-vercel-id"] || req.headers["x-request-id"] || crypto.randomUUID());
    const startedAt = Date.now();
    const cachePath = String(req.originalUrl || req.path || "").split("?")[0];
    req.requestId = requestId;
    res.setHeader("X-Request-Id", requestId);

    if (req.method === "GET" && PUBLIC_CACHE_PATHS.has(cachePath)) {
        res.setHeader("Cache-Control", "public, max-age=30, s-maxage=60, stale-while-revalidate=300");
    } else if (req.path.startsWith("/api/")) {
        res.setHeader("Cache-Control", "no-store");
    }

    res.on("finish", () => {
        const sampleRate = Number(process.env.REQUEST_LOG_SAMPLE_RATE || (IS_PRODUCTION_RUNTIME ? 0.01 : 0));
        if (res.statusCode >= 500 || Math.random() < sampleRate) {
            console.log(JSON.stringify({
                level: res.statusCode >= 500 ? "error" : "info",
                message: "request_completed",
                requestId,
                method: req.method,
                path: req.path,
                status: res.statusCode,
                durationMs: Date.now() - startedAt
            }));
        }
    });
    next();
});

