function emailProviderConfigured() {
    if (EMAIL_PROVIDER === "mock") return true;
    if (EMAIL_PROVIDER === "none") return false;
    if (["gmail", "smtp", "nodemailer"].includes(EMAIL_PROVIDER)) return Boolean(process.env.EMAIL_USER && process.env.EMAIL_PASS);
    if (EMAIL_PROVIDER === "sendgrid") return Boolean(process.env.SENDGRID_API_KEY && (process.env.EMAIL_FROM || process.env.EMAIL_USER));
    if (EMAIL_PROVIDER === "brevo") return Boolean(process.env.BREVO_API_KEY && (process.env.EMAIL_FROM || process.env.EMAIL_USER));
    if (EMAIL_PROVIDER === "mailgun") return Boolean(process.env.MAILGUN_API_KEY && process.env.MAILGUN_DOMAIN && (process.env.EMAIL_FROM || process.env.EMAIL_USER));
    return false;
}

function smsProviderConfigured() {
    if (SMS_PROVIDER === "mock") return true;
    if (SMS_PROVIDER === "twilio") return Boolean(process.env.TWILIO_ACCOUNT_SID && process.env.TWILIO_AUTH_TOKEN && (process.env.TWILIO_FROM_NUMBER || process.env.TWILIO_PHONE_NUMBER));
    if (SMS_PROVIDER === "msg91") return Boolean(process.env.MSG91_AUTH_KEY && process.env.MSG91_TEMPLATE_ID);
    if (SMS_PROVIDER === "fast2sms") return Boolean(process.env.FAST2SMS_API_KEY);
    if (SMS_PROVIDER === "textlocal") return Boolean(process.env.TEXTLOCAL_API_KEY);
    return false;
}

function withOtpSendTimeout(promise, timeoutMs, label) {
    let timer;
    const timeout = new Promise((_, reject) => {
        timer = setTimeout(() => reject(new Error(label)), timeoutMs);
    });
    return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
}
async function sendEmailOtp(user, otp, purpose) {
    const recipient = cleanEmail(user?.email);
    if (EMAIL_PROVIDER === "mock") {
        if (!recipient || !isValidEmail(recipient)) {
            console.log(`[MOCK EMAIL OTP] ${purpose} skipped, no valid email for ${user?.mobile || "mobile-only signup"}: ${otp}`);
            return { channel: "email", provider: "mock", skipped: true, sent: false, reason: "No valid email on account" };
        }
        console.log(`[MOCK EMAIL OTP] ${purpose} for ${recipient}: ${otp}`);
        return { channel: "email", provider: "mock", sent: true, to: recipient };
    }

    if (EMAIL_PROVIDER === "none") {
        return { channel: "email", provider: "none", skipped: true, sent: false, reason: "Email delivery is disabled" };
    }

    if (!recipient || !isValidEmail(recipient)) {
        return { channel: "email", provider: EMAIL_PROVIDER, skipped: true, sent: false, reason: "No valid email on account" };
    }

    if (!emailProviderConfigured()) {
        return { channel: "email", provider: EMAIL_PROVIDER, skipped: true, sent: false, reason: "Email provider is not configured" };
    }

    const from = process.env.EMAIL_FROM || process.env.EMAIL_USER;
    const subject = `EngiLearn ${purpose.replace(/-/g, " ")} OTP`;
    const text = otpText(otp);
    const html = otpHtml(otp);

    if (EMAIL_PROVIDER === "sendgrid") {
        await postJson("https://api.sendgrid.com/v3/mail/send", {
            Authorization: `Bearer ${process.env.SENDGRID_API_KEY}`
        }, {
            personalizations: [{ to: [{ email: recipient }] }],
            from: { email: String(from).replace(/^.*<|>.*$/g, "").trim() || from },
            subject,
            content: [
                { type: "text/plain", value: text },
                { type: "text/html", value: html }
            ]
        });
        return { channel: "email", provider: "sendgrid", sent: true, to: recipient };
    }

    if (EMAIL_PROVIDER === "brevo") {
        await postJson("https://api.brevo.com/v3/smtp/email", {
            "api-key": process.env.BREVO_API_KEY
        }, {
            sender: { email: String(from).replace(/^.*<|>.*$/g, "").trim() || from, name: "EngiLearn" },
            to: [{ email: recipient }],
            subject,
            textContent: text,
            htmlContent: html
        });
        return { channel: "email", provider: "brevo", sent: true, to: recipient };
    }

    if (EMAIL_PROVIDER === "mailgun") {
        const form = new URLSearchParams();
        form.set("from", from);
        form.set("to", recipient);
        form.set("subject", subject);
        form.set("text", text);
        form.set("html", html);
        await postForm(`https://api.mailgun.net/v3/${process.env.MAILGUN_DOMAIN}/messages`, {
            Authorization: `Basic ${Buffer.from(`api:${process.env.MAILGUN_API_KEY}`).toString("base64")}`,
            "Content-Type": "application/x-www-form-urlencoded"
        }, form);
        return { channel: "email", provider: "mailgun", sent: true, to: recipient };
    }

    await transporter.sendMail({
