    });
    delete record.otp;
    delete record.otpHash;
    delete record.otpPurpose;
    delete record.otpExpiresAt;
    delete record.passwordResetVerified;
    delete record.resetPasswordHash;
    delete record.refreshTokenHash;
    return record;
}

async function upstashRedisCommand(parts) {
    if (!authBackupEnabled()) return null;
    const endpoint = `${AUTH_BACKUP_REDIS_URL}/${parts.map((part) => encodeURIComponent(String(part))).join("/")}`;
    const response = await fetch(endpoint, { headers: { Authorization: `Bearer ${AUTH_BACKUP_REDIS_TOKEN}` } });
    if (!response.ok) throw new Error(`Auth backup ${parts[0]} failed (${response.status})`);
    const payload = await response.json().catch(() => ({}));
    return payload?.result;
}

async function supabaseKvRequest(path, options = {}) {
    if (!supabaseAuthBackupEnabled()) return null;
    const response = await fetch(`${SUPABASE_URL}/rest/v1/${path}`, {
        ...options,
        headers: {
            apikey: SUPABASE_SECRET_KEY,
            Authorization: `Bearer ${SUPABASE_SECRET_KEY}`,
            ...(options.headers || {})
        }
    });
    if ([401, 403, 404].includes(response.status)) {
        disableSupabaseAuthBackup(`disabled (${response.status}); create ${SUPABASE_KV_TABLE} table and set Supabase service role key in Vercel`);
        return null;
    }
    if (!response.ok) throw new Error(`Supabase auth backup failed (${response.status})`);
    if (response.status === 204) return null;
    return response.json().catch(() => null);
}

async function supabaseSetAuthBackup(key, value) {
    await supabaseKvRequest(SUPABASE_KV_TABLE, {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            Prefer: "resolution=merge-duplicates,return=minimal"
        },
        body: JSON.stringify({ key, value, updated_at: new Date().toISOString() })
    });
}

async function supabaseGetAuthBackup(key) {
    const rows = await supabaseKvRequest(`${SUPABASE_KV_TABLE}?key=eq.${encodeURIComponent(key)}&select=value`, {
        method: "GET"
    });
    return Array.isArray(rows) && rows[0] ? rows[0].value : null;
}

async function supabaseDeleteAuthBackup(key) {
    await supabaseKvRequest(`${SUPABASE_KV_TABLE}?key=eq.${encodeURIComponent(key)}`, {
        method: "DELETE",
        headers: { Prefer: "return=minimal" }
    });
}

async function backupAuthUser(user, reason = "auth") {
    if ((!authBackupEnabled() && !supabaseAuthBackupEnabled()) || !user) return false;
    const record = safeAuthBackupRecord(user);
    const keys = authBackupKeysForUser(record);
    if (!keys.length) return false;
    let saved = false;

    if (authBackupEnabled()) {
        try {
            const payload = JSON.stringify(record);
            await Promise.all(keys.map((key) => upstashRedisCommand(["SET", key, payload])));
            saved = true;
        } catch (error) {
            console.error(`[auth:${reason}] Vercel auth backup failed:`, error.message);
        }
    }

    if (supabaseAuthBackupEnabled()) {
        try {
            await Promise.all(keys.map((key) => supabaseSetAuthBackup(key, record)));
            saved = true;
        } catch (error) {
            console.error(`[auth:${reason}] Supabase auth backup failed:`, error.message);
        }
    }

    return saved;
}

async function deleteAuthUserBackup(user) {
    if ((!authBackupEnabled() && !supabaseAuthBackupEnabled()) || !user) return false;
    const keys = authBackupKeysForUser(user);
    if (!keys.length) return false;
    let deleted = false;

    if (authBackupEnabled()) {
        try {
            await upstashRedisCommand(["DEL", ...keys]);
            deleted = true;
        } catch (error) {
            console.error("[auth:delete] Vercel auth backup delete failed:", error.message);
        }
    }

    if (supabaseAuthBackupEnabled()) {
        try {
            await Promise.all(keys.map((key) => supabaseDeleteAuthBackup(key)));
            deleted = true;
        } catch (error) {
            console.error("[auth:delete] Supabase auth backup delete failed:", error.message);
        }
    }

    return deleted;
}

async function findAuthUserBackup(identifier, role = null) {
    if (!authBackupEnabled() && !supabaseAuthBackupEnabled()) return null;
    const selectedRole = isAutomaticRoleValue(role) ? null : normalizeRole(role);
    for (const key of authBackupLookupKeys(identifier)) {
        if (authBackupEnabled()) {
            try {
                const raw = await upstashRedisCommand(["GET", key]);
                if (raw) {
                    const record = typeof raw === "string" ? JSON.parse(raw) : raw;
                    const user = normalizeUser(record);
                    if (!selectedRole || normalizeRole(user.role) === selectedRole) return user;
                }
            } catch (error) {
                console.error("[auth:lookup] Vercel auth backup read failed:", error.message);
            }
        }

        if (supabaseAuthBackupEnabled()) {
            try {
                const record = await supabaseGetAuthBackup(key);
                if (record) {
                    const user = normalizeUser(record);
                    if (!selectedRole || normalizeRole(user.role) === selectedRole) return user;
                }
            } catch (error) {
                console.error("[auth:lookup] Supabase auth backup read failed:", error.message);
            }
        }
    }
    return null;
}

async function findAuthUserByIdentifierWithBackup(db, identifier, role = null) {
    const user = findAuthUserByIdentifier(db, identifier, role);
    if (user) return user;
    const backup = await findAuthUserBackup(identifier, role);
    if (!backup) return null;
    ensureCollections(db);
    const existing = findUserByIdentifier(db.users, backup.email || backup.mobile || identifier, backup.role);
    if (existing) return existing;
    db.users.push(backup);
    db.__authLookupRepaired = true;
    try {
        await upsertMongoAuthRecord("users", backup);
        await backupAuthUser(backup, "lookup-repair");
    } catch (error) {
        console.error("[auth:lookup] Persistent repair from auth backup failed:", error.message);
    }
    return backup;
}

function identifierOtpChannel(identifier) {
    const value = String(identifier || "").trim();
    if (isValidEmail(cleanEmail(value))) return "email";
    if (isValidMobile(cleanMobile(value))) return "sms";
    return "both";
}

function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

function isValidMobile(mobile) {
    return /^\+?\d{10,15}$/.test(mobile);
}

function isStrongPassword(password) {
    return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,72}$/.test(password);
}

function normalizeRole(role) {
    const value = String(role || "Student").toLowerCase();
    if (value === "admin") return "Admin";
    if (value === "teacher") return "Teacher";
    return "Student";
}

function normalizeUser(user) {
    user.role = normalizeRole(user.role);
    user.status = user.status || "Active";
    if (typeof user.isVerified !== "boolean") {
        user.isVerified = true;
    }
    if (typeof user.isApproved !== "boolean") {
        const pendingApproval = user.approvalStatus === "Pending Admin Approval"
            || user.activity === "Signup OTP sent"
            || user.activity === "Signup OTP verified; waiting for admin approval";
        user.isApproved = user.role === "Admin" || !pendingApproval;
    }
    user.branch = user.branch || "Computer Science & Engineering";
    user.semester = user.semester || "3";
    user.course = user.course || "";
    user.phone = user.phone || "";
    user.mobile = user.mobile || user.phone || "";
    user.admissionYear = user.admissionYear || "";
    user.about = user.about || "";
    if (user.role === "Admin") {
        const matchedAdmin = DEFAULT_ADMINS.find((admin) => {
            return admin.email.toLowerCase() === String(user.email || "").toLowerCase()
                || admin.adminId.toLowerCase() === String(user.adminId || "").toLowerCase();
        });
        user.adminId = matchedAdmin?.adminId || user.adminId || "ADMIN001";
        user.adminType = matchedAdmin?.adminType || user.adminType || (user.adminId === "ADMIN001" ? "main" : "content");
        user.department = user.department || matchedAdmin?.department || "LMS Control";
        user.designation = user.designation || matchedAdmin?.designation || "Administrator";
        user.permissions = user.permissions || matchedAdmin?.permissions || "Full website access";
    } else if (user.role === "Teacher") {
        user.teacherId = user.teacherId || `TEACHER${String(user.id || Date.now()).padStart(4, "0")}`;
        user.designation = user.designation || "Teacher";
        user.assignedSubjects = Array.isArray(user.assignedSubjects) ? user.assignedSubjects : [];
    } else {
        ensureStudentIdentity(user);
    }
    return user;
}

function signUser(user) {
    return jwt.sign({ id: user.id, email: user.email, role: user.role }, JWT_SECRET, { expiresIn: ACCESS_TOKEN_EXPIRES_IN });
}

function signRefreshToken(user, tokenId) {
    return jwt.sign({ id: user.id, tokenId }, REFRESH_TOKEN_SECRET, { expiresIn: `${REFRESH_TOKEN_EXPIRES_DAYS}d` });
}

function hashToken(value) {
    return crypto.createHash("sha256").update(String(value)).digest("hex");
}

function refreshCookieOptions() {
    return {
        httpOnly: true,
        secure: process.env.NODE_ENV === "production",
        sameSite: process.env.NODE_ENV === "production" ? "none" : "lax",
        maxAge: REFRESH_TOKEN_EXPIRES_DAYS * 24 * 60 * 60 * 1000,
        path: "/api/auth"
    };
}

async function issueAuthSession(res, db, user, message = "Login successful", req = null) {
    const tokenId = crypto.randomUUID();
    const refreshToken = signRefreshToken(user, tokenId);
    const accessToken = signUser(user);
    user.refreshTokenHash = hashToken(refreshToken);
    user.lastLogin = new Date().toISOString();
    user.failedLoginAttempts = 0;
    user.loginAttempts = 0;
    delete user.lockUntil;
    db.sessions = [{
        id: nextId(db.sessions || []),
        userId: user.id,
        role: user.role,
        tokenId,
        ip: req?.ip || req?.socket?.remoteAddress || "",
        userAgent: req?.headers?.["user-agent"] || "",
        createdAt: new Date().toISOString()
    }, ...(db.sessions || [])].slice(0, 250);
    await backupAuthUser(user, "session");
    await writeDbAndWait(db);
    res.cookie(COOKIE_NAME, refreshToken, refreshCookieOptions());
    return res.json({ message, accessToken, token: accessToken, user: publicUser(user) });
}

function clearRefreshCookie(res) {
    res.clearCookie(COOKIE_NAME, { ...refreshCookieOptions(), maxAge: undefined });
}

function tokenFromRequest(req) {
    const header = req.headers.authorization || "";
    return header.startsWith("Bearer ") ? header.slice(7) : header;
}

function isTokenBlacklisted(db, token) {
    if (!token) return false;
    const hashed = hashToken(token);
    const now = Date.now();
    db.tokenBlacklist = (db.tokenBlacklist || []).filter((item) => {
        return !item.expiresAt || new Date(item.expiresAt).getTime() > now;
    });
    return db.tokenBlacklist.some((item) => item.tokenHash === hashed);
}

