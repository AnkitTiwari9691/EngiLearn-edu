function canonicalPyqBranchKey(value) {
    const key = normalizePyqKeyValue(value).replace(/&/g, " and ").replace(/[^a-z0-9]+/g, " ").trim();
    if (!key) return "";
    if (key === "all" || key === "all branches" || key === "all b tech branches") return "all";
    return pyqBranchAliasMap.get(key) || key;
}

function pyqBranchKeys(item) {
    const rawBranches = [
        ...parsePyqBranchList(item?.branchIds),
        item?.branchId,
        ...parsePyqBranchList(item?.branchNames),
        item?.branch
    ].filter(Boolean);
    const normalized = rawBranches.map(canonicalPyqBranchKey).filter(Boolean);
    if (!normalized.length) return ["all"];
    if (normalized.includes("all")) {
        return ["all"];
    }
    return [...new Set(normalized)].sort();
}

function pyqSubjectKey(item) {
    const code = normalizePyqKeyValue(item?.subjectCode || item?.code).replace(/[^a-z0-9]/g, "");
    const subject = normalizePyqKeyValue(item?.subject || item?.title);
    if (code && subject) return `code:${code}|subject:${subject}`;
    if (code) return `code:${code}`;
    return `subject:${subject}`;
}

function pyqAcademicKey(item) {
    return [
        String(item?.semester || "").replace(/[^\d]/g, ""),
        pyqSubjectKey(item),
        String(item?.year || "").trim(),
        normalizePyqKeyValue(item?.session || item?.examSession || "")
    ].join("|");
}

function pyqBranchesOverlap(first, second) {
    const firstBranches = pyqBranchKeys(first);
    const secondBranches = pyqBranchKeys(second);
    if (firstBranches.includes("all") || secondBranches.includes("all")) return true;
    return firstBranches.some((branch) => secondBranches.includes(branch));
}

function pyqDuplicateKey(item) {
    return `${pyqBranchKeys(item).join(",")}|${pyqAcademicKey(item)}`;
}

function findPyqDuplicate(db, item, ignoreId = null) {
    const key = pyqAcademicKey(item);
    return (db.content || []).find((content) => (
        content.id !== ignoreId
        && String(content.type || "").toLowerCase().includes("pyq")
        && pyqAcademicKey(content) === key
        && pyqBranchesOverlap(content, item)
    ));
}

