        email: cleanEmail(user.email || user.emailAddress || ""),
        mobile: cleanMobile(user.mobile || user.phone || user.mobileNumber || user.phoneNumber || ""),
        identifier: user.identifier || user.primaryIdentifier || user.email || user.mobile || user.phone || "",
        authIdentifiers: Array.isArray(user.authIdentifiers) ? user.authIdentifiers.filter(Boolean) : [user.email, user.mobile, user.phone].filter(Boolean),
        phone: cleanMobile(user.phone || user.mobile || user.mobileNumber || user.phoneNumber || ""),
        role: normalizeRole(user.role),
        status: user.status || "Active",
        approvalStatus: user.approvalStatus || "Approved",
        passwordHash: user.passwordHash || "",
        ownPasswordCreated: Boolean(user.ownPasswordCreated),
        passwordCreated: Boolean(user.passwordCreated),
        isPasswordSet: Boolean(user.isPasswordSet),
        hasPassword: Boolean(user.hasPassword),
        firstLogin: Boolean(user.firstLogin),
        branch: user.branch || "",
        semester: user.semester || "",
        course: user.course || "",
        rollNumber: user.rollNumber || "",
        studentId: user.studentId || "",
        engilearnId: user.engilearnId || "",
