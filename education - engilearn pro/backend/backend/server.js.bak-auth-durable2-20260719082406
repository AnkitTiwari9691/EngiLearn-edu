app.post("/api/auth/resend-otp", async (req, res) => {
    const db = await readAuthDb("resend-otp");
    const identifier = req.body.identifier || req.body.email || req.body.mobile;
    const purpose = String(req.body.purpose || "signup").trim();
    const role = req.body.role ? normalizeRole(req.body.role) : null;
    const collection = purpose === "signup" ? (db.signupRequests || []) : db.users;
    const user = findUserByIdentifier(collection, identifier, role);
    if (!user) return res.status(404).json({ message: purpose === "signup" ? "Signup OTP request not found" : "Account not found" });
    if (!["signup", "login", "reset-password"].includes(purpose)) {
        return res.status(400).json({ message: "Invalid OTP purpose" });
    }
    resetExpiredOtpWindow(user);
    const waitSeconds = otpCooldownSeconds(user);
    if (waitSeconds > 0) {
        await writeDbAndWait(db);
        return otpCooldownResponse(res, user);
    }

    if (Number(user.otpResendCount || 0) >= OTP_MAX_RESENDS) {
        return res.status(429).json({ message: "OTP resend limit reached. Please try again later." });
    }

    const otp = await setOtp(user, purpose, { incrementResend: true, preferredChannel: identifierOtpChannel(identifier) });
    if (!otpDeliveryOk(user)) {
        const body = otpDeliveryFailedBody(user);
        clearOtp(user);
        await writeDbAndWait(db);
        return res.status(502).json(body);
    }

    await writeDbAndWait(db);
    res.json({ message: "OTP resent successfully", expiresInMinutes: otpExpiresMinutes(), ...otpResponseExtra(user, otp) });
});

