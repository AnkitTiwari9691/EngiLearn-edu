        .find((value) => value && !isGeneratedStudentId(value));
    const accountId = existing ? existing.replace(/^EL(?=\d)/i, "EL-").toUpperCase() : formatEngiLearnStudentId(sequence || user.id || Date.now());
    user.studentId = user.studentId && !isGeneratedStudentId(user.studentId) ? String(user.studentId).trim().toUpperCase() : accountId;
    user.engilearnId = user.engilearnId && !isGeneratedStudentId(user.engilearnId) ? String(user.engilearnId).trim().toUpperCase() : accountId;
    user.rollNumber = user.rollNumber && !isGeneratedStudentId(user.rollNumber) ? String(user.rollNumber).trim().toUpperCase() : accountId;
    const photoUrl = String(user.photoUrl || user.profilePhoto || user.avatarUrl || "").trim();
    user.photoUrl = photoUrl;
    user.profilePhoto = photoUrl;
    return user;
}

function immutableStudentIdentity(user) {
    if (!user || normalizeRole(user.role) !== "Student") return null;
    ensureStudentIdentity(user);
    const accountId = [user.studentId, user.engilearnId, user.rollNumber]
        .map((value) => String(value || "").trim())
        .find((value) => value && !isGeneratedStudentId(value));
    return accountId ? accountId.replace(/^EL(?=\d)/i, "EL-").toUpperCase() : null;
}

function restoreImmutableStudentIdentity(user, accountId) {
    if (!user || normalizeRole(user.role) !== "Student") return user;
    const stableId = String(accountId || "").trim().replace(/^EL(?=\d)/i, "EL-").toUpperCase();
    if (!stableId) return ensureStudentIdentity(user);
    user.studentId = stableId;
    user.engilearnId = stableId;
    user.rollNumber = stableId;
    return user;
}

function isApprovedAdmin(user) {
    const adminId = String(user.adminId || "").toLowerCase();
    const email = String(user.email || "").toLowerCase();
    return DEFAULT_ADMIN_IDS.has(adminId) || DEFAULT_ADMIN_EMAILS.has(email);
}

function ensureAdminAccounts(db) {
    const studentsAndApprovedAdmins = (db.users || []).map((user) => {
        const normalized = normalizeUser(user);
        if (normalized.role === "Admin" && !isApprovedAdmin(normalized)) {
            normalized.role = "Student";
            ensureStudentIdentity(normalized);
            normalized.activity = "Converted to student because only three admin accounts are allowed";
            delete normalized.adminId;
            delete normalized.permissions;
        }
        return normalized;
    });

    const usersById = new Map(studentsAndApprovedAdmins.map((user) => [Number(user.id), user]));
    const users = [...studentsAndApprovedAdmins];

    DEFAULT_ADMINS.forEach((admin) => {
        const existing = users.find((user) => {
            return String(user.email || "").toLowerCase() === admin.email.toLowerCase()
                || String(user.adminId || "").toLowerCase() === admin.adminId.toLowerCase();
        });

        if (existing) {
            const before = JSON.stringify({
                name: existing.name,
                email: existing.email,
                mobile: existing.mobile,
                phone: existing.phone,
                adminId: existing.adminId,
                role: existing.role,
                status: existing.status,
                adminType: existing.adminType,
                department: existing.department,
                designation: existing.designation,
                permissions: existing.permissions,
                ownPasswordCreated: existing.ownPasswordCreated,
                mustSetPassword: existing.mustSetPassword
            });
            existing.name = existing.name || admin.name;
            existing.email = admin.email;
            existing.mobile = admin.mobile || existing.mobile || "";
            existing.phone = admin.mobile || existing.phone || "";
            existing.adminId = admin.adminId;
            existing.role = "Admin";
            existing.status = existing.status || "Active";
            existing.adminType = admin.adminType;
            existing.department = admin.department;
            existing.designation = admin.designation;
            existing.permissions = admin.permissions;
            if ((!existing.ownPasswordCreated && !existing.mustSetPassword) || hasKnownPresetPassword(existing, DEFAULT_ADMIN_PASSWORDS)) {
                requireOwnPassword(existing, "Admin must create an own password with OTP");
            }
            normalizeUser(existing);
            const after = JSON.stringify({
                name: existing.name,
                email: existing.email,
                mobile: existing.mobile,
                phone: existing.phone,
                adminId: existing.adminId,
                role: existing.role,
                status: existing.status,
                adminType: existing.adminType,
                department: existing.department,
                designation: existing.designation,
                permissions: existing.permissions,
                ownPasswordCreated: existing.ownPasswordCreated,
                mustSetPassword: existing.mustSetPassword
            });
            if (before !== after) db.__authLookupRepaired = true;
            usersById.set(Number(existing.id), existing);
            return;
        }

        const nextAdminId = nextId([...usersById.values()]);
        const newAdmin = buildDefaultAdmin(admin, nextAdminId);
        db.__authLookupRepaired = true;
        usersById.set(Number(newAdmin.id), newAdmin);
    });

    DEFAULT_ADMINS.forEach((admin) => {
        const matches = [...usersById.values()].filter((user) => {
            return normalizeRole(user.role) === "Admin"
                && (String(user.adminId || "").toLowerCase() === admin.adminId.toLowerCase()
                    || String(user.email || "").toLowerCase() === admin.email.toLowerCase());
        });
        if (matches.length <= 1) return;
        const preferred = matches.find((user) => String(user.email || "").toLowerCase() === admin.email.toLowerCase())
            || matches.find((user) => String(user.adminId || "").toLowerCase() === admin.adminId.toLowerCase())
            || matches[0];
        matches.forEach((user) => {
            if (Number(user.id) === Number(preferred.id)) return;
            usersById.delete(Number(user.id));
            db.__authLookupRepaired = true;
        });
    });
    db.users = [...usersById.values()].sort((a, b) => Number(a.id) - Number(b.id));
}

