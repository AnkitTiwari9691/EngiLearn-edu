function cleanEmail(value) {
    const raw = String(value || "").trim().toLowerCase();
    if (!raw.includes("@")) return raw;
    const parts = raw.split("@");
    if (parts.length !== 2) return raw;
    const local = parts[0].trim();
    const domain = parts[1].trim().replace(/\s+/g, "");
    const gmailDomainFixes = new Map([
        ["gamil.com", "gmail.com"],
        ["gmial.com", "gmail.com"],
        ["gmai.com", "gmail.com"],
        ["gmal.com", "gmail.com"],
        ["gmaill.com", "gmail.com"],
        ["gmail.con", "gmail.com"],
        ["gmail.co", "gmail.com"],
        ["gnail.com", "gmail.com"]
    ]);
    return `${local}@${gmailDomainFixes.get(domain) || domain}`;
}

function cleanMobile(value) {
