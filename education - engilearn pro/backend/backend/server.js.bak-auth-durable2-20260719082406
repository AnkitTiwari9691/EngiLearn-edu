function repeatedQuestionPayload(body = {}, current = {}) {
    const branchId = String(body.branchId || current.branchId || "cse").trim().toLowerCase();
    const branch = String(body.branch || current.branch || "Computer Science & Engineering").trim();
    const question = String(body.question || body.topic || current.question || current.topic || "").trim();
    const years = [...new Set((Array.isArray(body.years) ? body.years : String(body.years || current.years || "")
        .split(/[,\s]+/))
        .map((year) => Number(String(year).replace(/[^\d]/g, "")))
        .filter((year) => year >= 2000 && year <= 2100))]
        .sort((a, b) => b - a);
    const repeatCount = Math.max(1, Number(body.repeatCount || current.repeatCount || years.length || 1));
    const unit = String(body.unit || current.unit || "extra").trim().toLowerCase().replace(/\s+/g, "-");
    const unitLabel = String(body.unitLabel || current.unitLabel || (/^\d+$/.test(unit) ? `Unit ${unit}` : "Extra Questions")).trim();
    return {
        title: String(body.title || current.title || `${body.subject || current.subject || "Subject"} repeated question`).trim(),
        type: "Repeated Question",
        branch,
        branchId,
        branchIds: [branchId],
        branchNames: [branch],
        semester: String(body.semester || current.semester || "").replace(/[^\d]/g, ""),
        subject: String(body.subject || current.subject || "").trim(),
        subjectCode: String(body.subjectCode || current.subjectCode || "").trim(),
        year: String(years[0] || body.year || current.year || "All"),
        years,
        unit,
        unitLabel,
        repeatCount,
        question,
        topic: question,
        description: String(body.description || current.description || "").trim(),
        source: String(body.source || current.source || "Admin managed"),
        isActive: body.isActive === false || String(body.isActive).toLowerCase() === "false" ? false : true
    };
}

function repeatedQuestionDuplicate(db, candidate, ignoredId = null) {
    const normalizedQuestion = String(candidate.question || "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
    return (db.content || []).find((item) => (
        item.id !== ignoredId
        && String(item.type || "").toLowerCase() === "repeated question"
        && String(item.branchId || "").toLowerCase() === String(candidate.branchId || "").toLowerCase()
        && String(item.semester || "") === String(candidate.semester || "")
        && String(item.subjectCode || "").toLowerCase().replace(/[^a-z0-9]/g, "") === String(candidate.subjectCode || "").toLowerCase().replace(/[^a-z0-9]/g, "")
        && String(item.unit || "") === String(candidate.unit || "")
        && String(item.question || item.topic || "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim() === normalizedQuestion
    ));
}

