app.post("/api/auth/request-signup-otp", async (req, res) => {
    const db = await readAuthDb("request-signup-otp");
    const { email, mobile } = signupIdentifier(req);
    const name = String(req.body.name || (email ? email.split("@")[0] : "New User")).trim();
    const requestedRole = normalizeRole(req.body.role);

    if (!name) {
        return res.status(400).json({ message: "Name is required" });
    }

    if (!isValidEmail(email)) {
        return res.status(400).json({ message: "Enter a valid email address" });
    }

    if (!isValidMobile(mobile)) {
        return res.status(400).json({ message: "Enter a valid mobile number for real SMS OTP" });
    }

    if (!["Student", "Teacher"].includes(requestedRole)) {
        return res.status(403).json({ message: "Only student and teacher accounts can request signup approval." });
    }

    if (db.users.some((user) => (email && userMatchesIdentifier(user, email)) || (mobile && userMatchesIdentifier(user, mobile)))) {
        return res.status(400).json({ message: "Email or mobile already registered" });
    }

    const existingRequest = findSignupRequest(db, { email, mobile, role: requestedRole });
    if (existingRequest) {
        resetExpiredOtpWindow(existingRequest);
        const waitSeconds = otpCooldownSeconds(existingRequest);
        if (waitSeconds > 0) {
            await writeDbAndWait(db);
            return otpCooldownResponse(res, existingRequest);
        }
    }

    db.signupRequests = (db.signupRequests || []).filter((item) => {
        return !((email && cleanEmail(item.email) === email) || (mobile && cleanMobile(item.mobile || item.phone) === mobile));
    });
    await deleteMongoSignupRequestsByIdentifier({ email, mobile });

    const request = {
        id: nextId(db.signupRequests || []),
        name,
        email,
        mobile,
        phone: mobile,
        branch: String(req.body.branch || "Computer Science & Engineering"),
        semester: String(req.body.semester || "3"),
        course: String(req.body.course || ""),
        admissionYear: String(req.body.admissionYear || "").trim(),
        about: String(req.body.about || "").trim(),
