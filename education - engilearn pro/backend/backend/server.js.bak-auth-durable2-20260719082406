}


async function readAuthDb(routeName = "auth") {
    const ready = await ensureAuthDatabase();
    if (REQUIRE_MONGO && !ready && !isMongoReady() && !durableAuthBackupEnabled()) {
        const error = new Error("EngiLearn account database is starting. Please try again in a few seconds.");
        error.statusCode = 503;
        error.routeName = routeName;
        throw error;
    }

    const db = readDb();
    if (isMongoReady()) {
        try {
            const mongoAuthDb = await readMongoAuthUsersDb();
            if (mongoAuthDb && (mongoAuthDb.users || []).length) {
                mongoAuthDb.__authOnly = true;
                return mongoAuthDb;
            }
        } catch (error) {
            console.error(`[auth:${routeName}] Mongo account refresh failed:`, error.message);
            if (IS_PRODUCTION_RUNTIME || REQUIRE_MONGO) {
                if (!durableAuthBackupEnabled()) {
                    const dbError = new Error("EngiLearn account database is temporarily unavailable. Please try again.");
                    dbError.statusCode = 503;
                    dbError.routeName = routeName;
                    throw dbError;
                }
                console.warn(`[auth:${routeName}] Mongo account refresh failed; using auth backup fallback when available.`);
            }
        }
    }

    ensureCollections(db);
    return db;
}

