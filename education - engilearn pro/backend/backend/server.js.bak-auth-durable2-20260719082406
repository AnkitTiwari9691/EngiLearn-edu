    if (error?.message === "CORS origin not allowed") {
        return res.status(403).json({ message: "Origin not allowed" });
    }
    if (error?.code === "LIMIT_FILE_SIZE") {
        return res.status(413).json({ message: "Uploaded file is too large" });
    }
    if (error?.type === "entity.too.large") {
        return res.status(413).json({ message: "Request data is too large" });
    }
    if (error instanceof SyntaxError && error.status === 400) {
        return res.status(400).json({ message: "Invalid request data" });
    }
    console.error(`[${req.requestId || "no-request-id"}] Request failed:`, error?.message || error);
    res.status(500).json({ message: "Internal server error", requestId: req.requestId || null });
});

