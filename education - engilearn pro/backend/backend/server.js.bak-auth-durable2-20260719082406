app.post("/api/auth/logout", (req, res) => {
    const db = readDb();
    const accessToken = tokenFromRequest(req);
    const token = req.cookies?.[COOKIE_NAME];
    let userId = null;
    try {
        userId = token ? jwt.verify(token, REFRESH_TOKEN_SECRET).id : null;
    } catch (error) {
        userId = null;
    }
    if (!userId && req.headers.authorization) {
        try {
            const bearer = req.headers.authorization.replace(/^Bearer\s+/i, "");
            userId = jwt.verify(bearer, JWT_SECRET).id;
        } catch (error) {
            userId = null;
        }
    }
    const user = db.users.find((item) => item.id === userId);
    if (user) delete user.refreshTokenHash;
    if (accessToken) {
        const decoded = jwt.decode(accessToken);
        db.tokenBlacklist = [{
            id: nextId(db.tokenBlacklist || []),
            tokenHash: hashToken(accessToken),
            userId,
            expiresAt: decoded?.exp ? new Date(decoded.exp * 1000).toISOString() : new Date(Date.now() + 15 * 60 * 1000).toISOString(),
            createdAt: new Date().toISOString()
        }, ...(db.tokenBlacklist || [])].slice(0, 500);
    }
    db.sessions = (db.sessions || []).filter((session) => session.userId !== userId);
    logAudit(db, req, "Logout", user ? user.email || user.mobile : "Unknown user", user);
    writeDb(db);
    clearRefreshCookie(res);
    res.json({ message: "Logout successful" });
});

