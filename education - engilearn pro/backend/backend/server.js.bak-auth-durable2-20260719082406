async function hydrateProductionDbIfReady() {
    if (!isMongoReady()) return false;
    if (!productionDbHydrated) {
        await hydrateDbFromMongo();
        productionDbHydrated = true;
    }
    return true;
}

async function ensureProductionDatabase() {
    const productionRuntime = process.env.NODE_ENV === "production" || process.env.VERCEL === "1";
    if (!productionRuntime) return true;

    if (isMongoReady()) {
        return hydrateProductionDbIfReady();
    }

    if (!productionDbReadyPromise) {
        productionDbReadyPromise = connectDB()
            .then(async (connected) => {
                if (connected) {
                    await hydrateProductionDbIfReady();
                }
                return connected;
            })
            .finally(() => {
                if (!isMongoReady()) productionDbReadyPromise = null;
            });
    }

    return productionDbReadyPromise;
}

async function ensureAuthDatabase() {
    const productionRuntime = process.env.NODE_ENV === "production" || process.env.VERCEL === "1";
    if (!productionRuntime) return true;
