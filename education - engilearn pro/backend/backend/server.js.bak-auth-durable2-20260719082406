app.post("/api/student/assignments/:id/submit", requireAuth, requireStudent, upload.single("file"), (req, res) => {
    const db = readDb();
    const assignment = db.assignments.find((item) => item.id === Number(req.params.id));
    if (!assignment || !studentScope(req.currentUser, assignment)) {
        return res.status(404).json({ message: "Assignment not found for your course" });
    }
    const previous = db.submissions.find((item) => item.userId === req.currentUser.id && item.assignmentId === assignment.id);
    const submission = previous || {
        id: nextId(db.submissions),
        userId: req.currentUser.id,
        studentName: req.currentUser.name,
        assignmentId: assignment.id
    };
    Object.assign(submission, {
        text: String(req.body.text || "").trim(),
        fileUrl: req.file ? `/uploads/${req.file.filename}` : (submission.fileUrl || ""),
        fileMeta: filePayload(req.file),
        submittedAt: new Date().toISOString(),
        status: "Submitted"
    });
    if (!previous) db.submissions.push(submission);
    writeDb(db);
    res.status(previous ? 200 : 201).json({ submission });
});

function teacherScope(teacher, item) {
    return (!item.branch || item.branch === teacher.branch)
        && (!item.semester || String(item.semester) === String(teacher.semester))
        && (!item.course || item.course === teacher.course);
}

