function safeResolveDownloadPath(rootDir, relativePath) {
    const root = path.resolve(rootDir);
    const decoded = (() => {
        try {
            return decodeURIComponent(String(relativePath || ""));
        } catch (error) {
            return String(relativePath || "");
        }
    })();
    const cleaned = decoded.replace(/^[/\\]+/, "").replace(/[\\/]+/g, path.sep);
    const resolved = path.resolve(root, cleaned);
    if (resolved !== root && !resolved.startsWith(`${root}${path.sep}`)) return "";
    return resolved;
}

function pyqDownloadFileName(item, filePath) {
    const raw = String(item?.fileName || item?.filename || path.basename(filePath) || "rgpv-pyq.pdf");
    const safe = raw.replace(/[<>:"/\\|?*\x00-\x1F]+/g, "-").replace(/\s+/g, " ").trim();
    return /\.pdf$/i.test(safe) ? safe : `${safe || "rgpv-pyq"}.pdf`;
}

function resolvePyqDownloadPath(item) {
    const candidates = [
        item?.datasetRelativePath,
        item?.fileUrl,
        item?.filePath,
        item?.url
    ].map((value) => String(value || "").trim()).filter(Boolean);

    for (const candidate of candidates) {
        const withoutOrigin = candidate.replace(/^https?:\/\/[^/]+/i, "");
        if (withoutOrigin.startsWith("/pyq-files/") || withoutOrigin.startsWith("pyq-files/")) {
            const relativePath = withoutOrigin.replace(/^\/?pyq-files[\\/]/i, "");
            const filePath = safeResolveDownloadPath(PYQ_LIBRARY_DIR, relativePath);
            if (filePath && fs.existsSync(filePath)) return filePath;
        }
        if (withoutOrigin.startsWith("/uploads/") || withoutOrigin.startsWith("uploads/")) {
            const relativePath = withoutOrigin.replace(/^\/?uploads[\\/]/i, "");
            const filePath = safeResolveDownloadPath(UPLOAD_DIR, relativePath);
            if (filePath && fs.existsSync(filePath)) return filePath;
        }
        if (!withoutOrigin.startsWith("/") && !/^[a-z]+:/i.test(withoutOrigin)) {
            const filePath = safeResolveDownloadPath(PYQ_LIBRARY_DIR, withoutOrigin);
            if (filePath && fs.existsSync(filePath)) return filePath;
        }
    }

    return "";
}

function resolvePyqRemoteUrl(item) {
    const candidates = [
        item?.downloadUrl,
        item?.sourceUrl,
        item?.remoteUrl,
        item?.fileUrl,
        item?.filePath,
        item?.url
    ].map((value) => String(value || "").trim()).filter(Boolean);

    for (const candidate of candidates) {
        if (!/^https?:\/\//i.test(candidate)) continue;
        try {
            const parsed = new URL(candidate);
            if (parsed.protocol === "http:" || parsed.protocol === "https:") return parsed.href;
        } catch (error) {
            // Ignore malformed external source URLs.
        }
    }
    return "";
}

function findPyqContentByIdOrPath(db, requestedIdOrPath) {
    const requested = String(requestedIdOrPath || "").replace(/^upload-/i, "").trim();
    const normalizedPath = requested.replace(/^https?:\/\/[^/]+/i, "").replace(/^\/?pyq-files[\\/]/i, "").replace(/\\/g, "/");
    return (db.content || []).find((content) => {
        if (!String(content.type || "").toLowerCase().includes("pyq")) return false;
        if (String(content.id) === requested) return true;
        return [content.datasetRelativePath, content.fileUrl, content.filePath, content.url]
            .map((value) => String(value || "").trim())
            .some((value) => value.replace(/^https?:\/\/[^/]+/i, "").replace(/^\/?pyq-files[\\/]/i, "").replace(/\\/g, "/") === normalizedPath);
    });
}

async function findPublicPayloadPyqContentByIdOrPath(requestedIdOrPath) {
    const payload = await publicContentPayloadFresh();
    try {
        return findPyqContentByIdOrPath(JSON.parse(payload), requestedIdOrPath);
    } catch (error) {
        console.error("Public PYQ payload lookup failed:", error.message);
        return null;
    }
}
async function findMongoPyqContentByIdOrPath(requestedIdOrPath) {
    if (!isMongoReady()) return null;
    const requested = String(requestedIdOrPath || "").replace(/^upload-/i, "").trim();
    const normalizedPath = requested.replace(/^https?:\/\/[^/]+/i, "").replace(/^\/?pyq-files[\\/]/i, "").replace(/\\/g, "/");
    const pathVariants = Array.from(new Set([
        normalizedPath,
        `/pyq-files/${normalizedPath}`,
        `pyq-files/${normalizedPath}`
    ].filter(Boolean)));
    const or = [
        { appId: requested },
        { id: requested },
        ...pathVariants.flatMap((value) => ([
            { datasetRelativePath: value },
            { fileUrl: value },
            { filePath: value },
            { url: value }
        ]))
    ];
    const numericId = Number(requested);
    if (Number.isFinite(numericId)) {
        or.push({ appId: numericId }, { id: numericId });
    }
    return mongoose.connection.db.collection("content").findOne({
        $and: [
            { $or: or },
            { type: /pyq/i }
        ]
    });
}

async function sendPyqPdf(req, res, item) {
    const filePath = resolvePyqDownloadPath(item);
    const fileName = pyqDownloadFileName(item, filePath || item?.fileName || item?.url || "rgpv-pyq.pdf");
    const shouldDownload = req.query.download === "1" || req.query.download === "true";
    res.setHeader("Cache-Control", "no-store");
    res.setHeader("Content-Type", "application/pdf");
    res.setHeader("Content-Disposition", `${shouldDownload ? "attachment" : "inline"}; filename="${fileName.replace(/["\r\n]/g, "")}"`);

    if (filePath) {
        return res.sendFile(filePath, (error) => {
            if (error && !res.headersSent) {
                res.status(500).json({ message: "Unable to open PYQ PDF" });
            }
        });
    }

    const remoteUrl = resolvePyqRemoteUrl(item);
    if (!remoteUrl) {
        return res.status(404).json({ message: "PYQ PDF file not found" });
    }

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15000);
    try {
        const upstream = await fetch(remoteUrl, {
            signal: controller.signal,
            headers: {
                "User-Agent": "Mozilla/5.0 EngiLearn PYQ Viewer",
                "Accept": "application/pdf,*/*;q=0.8"
            }
        });
        clearTimeout(timeout);
        if (!upstream.ok) {
            return res.status(upstream.status === 403 ? 502 : upstream.status).json({ message: "PYQ PDF source is unavailable" });
        }
        const buffer = Buffer.from(await upstream.arrayBuffer());
        res.setHeader("Content-Length", String(buffer.length));
        return res.send(buffer);
    } catch (error) {
        clearTimeout(timeout);
        return res.status(502).json({ message: "Unable to open PYQ PDF source" });
    }
}

