    });
});

function isAccountApprovalRequired(settings, role) {
    const approval = settings?.accountApproval || {};
    const legacyEnabled = boolValue(approval.enabled, true);
    const normalizedRole = normalizeRole(role);
    if (normalizedRole === "Teacher") return boolValue(approval.teacherEnabled, legacyEnabled);
    if (normalizedRole === "Student") return boolValue(approval.studentEnabled, legacyEnabled);
    return legacyEnabled;
}

function ensureAccountApprovalAllowed(db, user) {
    if (!user || normalizeRole(user.role) === "Admin") return true;
    if (user.isApproved !== false) return true;
    if (isAccountApprovalRequired(db.settings, user.role)) return false;

    user.isApproved = true;
    user.approvalStatus = "Approved";
    user.approvedAt = user.approvedAt || new Date().toISOString();
    user.approvedBy = user.approvedBy || "System";
    user.activity = `${normalizeRole(user.role)} approval disabled; account activated automatically`;
    return true;
}
async function createSignup(req, res) {
    const db = await readAuthDb("signup");
    const { email, mobile } = signupIdentifier(req);
    const requestedRole = normalizeRole(req.body.role);
    const password = String(req.body.password || "");
    const approvalRequired = isAccountApprovalRequired(db.settings, requestedRole);
    let request = findSignupRequest(db, { email, mobile, role: requestedRole });
    if (!request) {
        request = await readMongoSignupRequestByIdentifier({ email, mobile, role: requestedRole });
        if (request) {
            db.signupRequests = (db.signupRequests || []).filter((item) => item.id !== request.id);
            db.signupRequests.push(request);
        }
    }

    if (!request) {
        return res.status(404).json({ message: "Signup OTP session expired. Please request OTP again." });
    }

    const result = await verifyOtpForUser(request, req.body.otp, "signup");
    if (!result.ok) {
        await writeDbAndWait(db);
        return res.status(400).json({ message: result.message });
    }

    if (!isStrongPassword(password)) {
        return res.status(400).json({ message: "Password needs 8+ chars with uppercase, lowercase, number, and symbol" });
    }

    if (db.users.some((user) => (request.email && userMatchesIdentifier(user, request.email)) || (request.mobile && userMatchesIdentifier(user, request.mobile)))) {
        return res.status(400).json({ message: "Email or mobile already registered" });
    }

    const userId = nextId(db.users);
    const studentAccountId = requestedRole === "Student" ? nextStudentAccountId(db) : "";
    const user = {
        id: userId,
        name: request.name,
        email: request.email,
        mobile: request.mobile,
        phone: request.mobile,
        identifier: request.email || request.mobile,
        authIdentifiers: [request.email, request.mobile].filter(Boolean),
        rollNumber: studentAccountId,
        studentId: studentAccountId,
        engilearnId: studentAccountId,
        teacherId: requestedRole === "Teacher" ? `TEACHER${Date.now()}` : "",
        branch: request.branch || "Computer Science & Engineering",
        semester: request.semester || "3",
        course: request.course || "",
        admissionYear: request.admissionYear || "",
        about: request.about || "",
        photoUrl: request.photoUrl || request.profilePhoto || "",
        profilePhoto: request.profilePhoto || request.photoUrl || "",
        passwordHash: await bcrypt.hash(password, 10),
        role: requestedRole,
        status: "Active",
        isVerified: true,
        isApproved: !approvalRequired,
        approvalStatus: approvalRequired ? "Pending Admin Approval" : "Approved",
        ownPasswordCreated: true,
        passwordCreated: true,
        isPasswordSet: true,
        hasPassword: true,
        firstLogin: false,
        activity: approvalRequired ? "Signup verified; waiting for admin approval" : "Signup verified; account activated automatically",
        joined: new Date().toISOString()
    };

    db.users.push(user);
    db.signupRequests = (db.signupRequests || []).filter((item) => item.id !== request.id);
    await upsertMongoAuthRecord("users", user);
    await backupAuthUser(user, "signup");
    await deleteMongoAuthRecord("signupRequests", request.id);
    await writeDbAndWait(db);
    res.status(201).json({
        message: approvalRequired ? "Password created. Your account request is waiting for admin approval." : "Password created. Your account is active and ready to login.",
        user: publicUser(user)
    });
}

