async function confirmMongoAuthUser(user) {
    if (!user || !isMongoReady()) return false;
    const mongoDb = await readMongoAuthUsersDb();
    const role = normalizeRole(user.role);
    return authUserIdentifiers(user).some((identifier) => findUserByIdentifier(mongoDb.users || [], identifier, role));
}

async function ensureDurableAuthUser(user, reason = "auth") {
    if (!user) return false;
    await backupAuthUser(user, reason);
    if (!isMongoReady()) {
        if (authStorageRequired()) {
            const error = new Error("Account storage is temporarily unavailable. Please try again.");
            error.statusCode = 503;
            throw error;
        }
        return true;
    }
    await upsertMongoAuthRecord("users", user);
    if (!(await confirmMongoAuthUser(user))) {
        const error = new Error("Account could not be saved permanently. Please try again.");
        error.statusCode = 503;
        throw error;
    }
    return true;
}

async function ensureDurableAuthSettings(db) {
    await writeDbAndWait(db);
    if (!isMongoReady()) {
        if (authStorageRequired()) {
            const error = new Error("Settings storage is temporarily unavailable. Please try again.");
            error.statusCode = 503;
            throw error;
        }
        return true;
    }
    const saved = await readMongoAuthUsersDb();
    const wanted = db?.settings?.accountApproval || {};
    const got = saved?.settings?.accountApproval || {};
    for (const key of ["enabled", "studentEnabled", "teacherEnabled"]) {
        if (Object.prototype.hasOwnProperty.call(wanted, key) && boolValue(got[key], true) !== boolValue(wanted[key], true)) {
            const error = new Error("Account approval setting could not be saved permanently. Please try again.");
            error.statusCode = 503;
            throw error;
        }
    }
    return true;
}

function authBackupLookupKeys(identifier) {
    const keys = new Set();
    const email = cleanEmail(identifier);
    if (isValidEmail(email)) keys.add(`${AUTH_BACKUP_PREFIX}email:${email}`);
    for (const key of mobileIdentifierKeys(identifier)) keys.add(`${AUTH_BACKUP_PREFIX}mobile:${key}`);
    return [...keys];
}

function authBackupKeysForUser(user) {
    const values = [
        user?.email,
        user?.emailAddress,
        user?.alternateEmail,
        user?.username,
        user?.loginId,
        user?.mobile,
        user?.phone,
        user?.mobileNumber,
        user?.phoneNumber,
        user?.contactNumber,
        user?.whatsapp,
        user?.whatsApp,
        user?.guardianMobile,
        user?.identifier
    ].filter(Boolean);
    const keys = new Set();
    for (const value of values) authBackupLookupKeys(value).forEach((key) => keys.add(key));
    return [...keys];
}

function safeAuthBackupRecord(user) {
    const record = normalizeUser({
