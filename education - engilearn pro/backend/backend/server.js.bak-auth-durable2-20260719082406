        user = buildDefaultAdmin(defaultAdmin, nextId(db.users));
        user.activity = "Default admin account restored for authentication";
        db.users.push(user);
        db.__authLookupRepaired = true;
        return user;
    }

    const before = JSON.stringify({
        email: user.email,
        mobile: user.mobile,
        phone: user.phone,
        adminId: user.adminId,
        role: user.role,
        status: user.status
    });
    user.email = defaultAdmin.email;
    user.mobile = defaultAdmin.mobile || user.mobile || "";
    user.phone = defaultAdmin.mobile || user.phone || "";
    user.adminId = defaultAdmin.adminId;
    user.role = "Admin";
    user.status = user.status || "Active";
    user.adminType = defaultAdmin.adminType;
    user.department = defaultAdmin.department;
    user.designation = defaultAdmin.designation;
    user.permissions = defaultAdmin.permissions;
    normalizeUser(user);
    const after = JSON.stringify({
        email: user.email,
        mobile: user.mobile,
        phone: user.phone,
        adminId: user.adminId,
        role: user.role,
        status: user.status
    });
    if (before !== after) db.__authLookupRepaired = true;
    return user;
}

function findAuthUserByIdentifier(db, identifier, role = null) {
    const selectedRole = isAutomaticRoleValue(role) ? null : normalizeRole(role);
    if (selectedRole === "Admin" && isBlockedEmailOnlyAdminIdentifier(identifier)) return null;
    if (selectedRole === "Admin") ensureAdminAccounts(db);
    if (selectedRole === "Admin") {
        return ensureDefaultAdminForIdentifier(db, identifier, selectedRole)
            || findDefaultAdminUser(db, identifier, selectedRole)
            || findUserByIdentifier(db.users, identifier, selectedRole);
    }
    return findUserByIdentifier(db.users, identifier, selectedRole)
        || ensureDefaultAdminForIdentifier(db, identifier, selectedRole)
        || findDefaultAdminUser(db, identifier, selectedRole);
}

async function persistAuthLookupRepair(db) {
