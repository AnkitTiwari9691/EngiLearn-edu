function filePayload(file) {
    if (!file) return {};
    return {
        fileName: file.originalname,
        filePath: `/uploads/${file.filename}`,
        fileType: file.mimetype,
        fileSize: file.size
    };
}

function boolValue(value, fallback = true) {
    if (typeof value === "boolean") return value;
    if (value === "true" || value === "on" || value === "1") return true;
    if (value === "false" || value === "off" || value === "0") return false;
    return fallback;
}

function normalizeAiTool(tool = {}) {
    const normalized = {
        id: tool.id,
        name: String(tool.name || "AI Tool").trim(),
        category: String(tool.category || "Study Assistant").trim(),
        description: String(tool.description || "").trim(),
        icon: String(tool.icon || "fas fa-robot").trim(),
        color: String(tool.color || "#2563eb").trim(),
        status: String(tool.status || (tool.isActive === false ? "Inactive" : "Active")).trim(),
        isActive: boolValue(tool.isActive ?? (tool.status !== "Inactive"), true),
        isVisible: boolValue(tool.isVisible ?? tool.visible, true),
        toolType: String(tool.toolType || tool.type || "chat").trim(),
        embedUrl: String(tool.embedUrl || "").trim(),
        toolUrl: String(tool.toolUrl || tool.url || tool.embedUrl || "").trim(),
        promptPlaceholder: String(tool.promptPlaceholder || "Ask your study question here...").trim(),
        createdAt: tool.createdAt || new Date().toISOString(),
        updatedAt: tool.updatedAt
    };
    normalized.status = normalized.isActive ? "Active" : "Inactive";
    return normalized;
}

function sortAiTools(tools = []) {
    return [...tools].sort((a, b) => {
        const aIndex = AI_TOOL_ORDER.indexOf(a.name);
        const bIndex = AI_TOOL_ORDER.indexOf(b.name);
        const aRank = aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex;
        const bRank = bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex;
        return aRank - bRank || String(a.name || "").localeCompare(String(b.name || ""));
    });
}

function studentScope(user, item) {
    return (!item.branch || item.branch === user.branch)
        && (!item.semester || String(item.semester) === String(user.semester))
        && (!item.course || item.course === user.course);
}

