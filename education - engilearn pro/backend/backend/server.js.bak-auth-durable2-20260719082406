app.get("/api/student/dashboard", requireAuth, requireStudent, (req, res) => {
    const db = readDb();
    const user = normalizeUser(req.currentUser);
    const lectures = db.lectures.filter((item) => studentScope(user, item));
    const assignments = db.assignments.filter((item) => studentScope(user, item));
    const liveClasses = db.liveClasses.filter((item) => studentScope(user, item));
    const notifications = db.notifications.filter((item) => {
        if (item.audience === "All Students") return true;
        if (item.audience === "Personal") {
            const sameUser = Number(item.targetUserId) === Number(user.id);
            const sameEmail = cleanEmail(item.targetEmail) && cleanEmail(item.targetEmail) === cleanEmail(user.email);
            return sameUser || sameEmail;
        }
        return studentScope(user, item);
    });
    const watchHistory = db.watchHistory.filter((item) => item.userId === user.id);
    const bookmarks = db.bookmarks.filter((item) => item.userId === user.id);
    const submissions = db.submissions.filter((item) => item.userId === user.id);
    const paymentSlips = (db.payments || []).filter((payment) => {
        const sameUser = Number(payment.userId) === Number(user.id);
        const sameEmail = cleanEmail(payment.studentEmail) && cleanEmail(payment.studentEmail) === cleanEmail(user.email);
        return (sameUser || sameEmail) && isVerifiedPayment(payment);
    }).sort((a, b) => new Date(b.verifiedAt || b.paidAt || b.createdAt || 0) - new Date(a.verifiedAt || a.paidAt || a.createdAt || 0));
    res.json({
        user: publicUser(user),
        announcement: db.settings?.announcement || "",
        lectures,
        assignments,
        liveClasses,
        notifications,
        watchHistory,
        bookmarks,
        submissions,
        paymentSlips,
        progress: {
            completed: watchHistory.filter((item) => Number(item.progress) >= 95).length,
            total: lectures.length,
            percent: lectures.length ? Math.round((watchHistory.filter((item) => Number(item.progress) >= 95).length / lectures.length) * 100) : 0
        }
    });
});

app.get("/api/student/lectures/:id", requireAuth, requireStudent, (req, res) => {
    const db = readDb();
    const lecture = db.lectures.find((item) => item.id === Number(req.params.id));
    if (!lecture || !studentScope(req.currentUser, lecture)) {
        return res.status(404).json({ message: "Lecture not found for your course" });
    }
    lecture.views = Number(lecture.views || 0) + 1;
    let history = db.watchHistory.find((item) => item.userId === req.currentUser.id && item.lectureId === lecture.id);
    if (!history) {
        history = {
            id: nextId(db.watchHistory),
            userId: req.currentUser.id,
            lectureId: lecture.id,
            progress: 0,
            lastPosition: 0,
            lastWatchedAt: new Date().toISOString()
        };
        db.watchHistory.push(history);
    } else {
        history.lastWatchedAt = new Date().toISOString();
    }
    writeDb(db);
    res.json({ lecture, history });
});

