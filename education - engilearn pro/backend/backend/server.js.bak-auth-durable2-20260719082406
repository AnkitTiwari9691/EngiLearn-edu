function matchesPaymentKey(payment, key) {
    return [payment?.id, payment?.providerOrderId, payment?.providerPaymentId, payment?.receipt, payment?.slipNumber, payment?.createdAt]
        .some((value) => String(value ?? "") === String(key || ""));
}

function isVerifiedPayment(payment) {
    const status = String(payment?.status || "").toLowerCase();
    const gatewayStatus = String(payment?.gatewayStatus || "").toLowerCase();
    return status === "paid" || gatewayStatus === "captured" || Boolean(payment?.verifiedAt && payment?.providerPaymentId);
}

function paymentSemesterValue(payment = {}) {
    const raw = payment.unlockedSemester ?? payment.semester ?? payment.semesterNumber ?? payment.selectedSemester ?? payment.targetSemester ?? "";
    const match = String(raw || "").match(/\d+/);
    return match ? match[0] : "";
}

function paymentAcademicLine(payment = {}) {
    const studentId = String(payment.studentId || payment.engilearnId || payment.rollNumber || "").trim();
    const branch = String(payment.branchName || payment.studentBranch || payment.branch || "").trim();
    const semester = paymentSemesterValue(payment);
    const parts = [];
    if (studentId) parts.push(`Student ID: ${studentId}`);
    if (branch) parts.push(`Branch: ${branch}`);
    if (semester) parts.push(`Semester: ${semester}`);
    return parts.join(" | ");
}

function receiptFileName(payment) {
    const key = payment?.slipNumber || payment?.providerPaymentId || payment?.providerOrderId || payment?.id || "receipt";
    return `engilearn-payment-receipt-${String(key).replace(/[^a-z0-9_-]+/gi, "-")}.pdf`;
}

function formatReceiptDate(value) {
    const date = new Date(value || Date.now());
    if (Number.isNaN(date.getTime())) return "Not available";
    return new Intl.DateTimeFormat("en-IN", {
        dateStyle: "medium",
        timeStyle: "short",
        timeZone: "Asia/Kolkata"
    }).format(date);
}

function writePaymentReceiptPdf(res, payment) {
    const doc = new PDFDocument({ size: "A4", margin: 48, info: {
        Title: "EngiLearn Payment Receipt",
        Author: "EngiLearn",
        Subject: `Payment receipt ${payment.slipNumber || payment.receipt || payment.id}`
    } });
    doc.pipe(res);

    const pageWidth = doc.page.width;
    const contentWidth = pageWidth - 96;
    const left = 48;
    const right = left + contentWidth;
    const ink = "#111111";
    const red = "#d71920";
    const muted = "#666666";
    const line = "#dedede";
    const green = "#168344";

    doc.rect(0, 0, pageWidth, 126).fill(ink);
    doc.fillColor("#ffffff").font("Helvetica-Bold").fontSize(24).text("EngiLearn", left, 42);
    doc.font("Helvetica").fontSize(9).fillColor("#d8d8d8").text("Engineering learning and academic services", left, 72);
    doc.font("Helvetica-Bold").fontSize(18).fillColor("#ffffff").text("PAYMENT RECEIPT", right - 205, 45, { width: 205, align: "right" });
    doc.rect(0, 122, pageWidth, 4).fill(red);

    const receiptNumber = payment.slipNumber || payment.receipt || payment.providerOrderId || `PAY-${payment.id}`;
    const paidDate = formatReceiptDate(payment.verifiedAt || payment.paidAt || payment.createdAt);
    doc.fillColor(ink).font("Helvetica-Bold").fontSize(10).text("RECEIPT NUMBER", left, 154);
    doc.fillColor(muted).font("Helvetica").fontSize(10).text(String(receiptNumber), left, 171, { width: 260 });
    doc.fillColor(ink).font("Helvetica-Bold").fontSize(10).text("PAID DATE", right - 220, 154, { width: 220, align: "right" });
    doc.fillColor(muted).font("Helvetica").fontSize(10).text(paidDate, right - 220, 171, { width: 220, align: "right" });
    doc.roundedRect(right - 92, 198, 92, 30, 5).fill(green);
    doc.fillColor("#ffffff").font("Helvetica-Bold").fontSize(11).text("PAID", right - 92, 208, { width: 92, align: "center" });

    doc.roundedRect(left, 248, contentWidth, 105, 7).fillAndStroke("#f6f6f6", line);
    doc.fillColor(red).font("Helvetica-Bold").fontSize(9).text("RECEIVED FROM", left + 18, 266);
    doc.fillColor(ink).font("Helvetica-Bold").fontSize(15).text(String(payment.studentName || payment.name || "EngiLearn Student"), left + 18, 286, { width: contentWidth - 36 });
    doc.fillColor(muted).font("Helvetica").fontSize(9)
        .text(String(payment.studentEmail || "Email not added"), left + 18, 311, { width: contentWidth / 2 - 20 })
        .text(String(payment.studentMobile || "Mobile not added"), left + contentWidth / 2, 311, { width: contentWidth / 2 - 18, align: "right" });

    const detailsTop = 386;
    doc.fillColor(ink).font("Helvetica-Bold").fontSize(13).text("Payment details", left, detailsTop);
    doc.moveTo(left, detailsTop + 24).lineTo(right, detailsTop + 24).strokeColor(line).lineWidth(1).stroke();
    const academicLine = paymentAcademicLine(payment);
    const detailRows = [
        ["Product", payment.type || payment.product || "EngiLearn Access"],
        ...(academicLine ? [["Unlocked details", academicLine]] : []),
        ["Payment provider", payment.provider || "Razorpay"],
        ["Order ID", payment.providerOrderId || payment.orderId || payment.receipt || "Not available"],
        ["Payment ID / UTR", payment.providerPaymentId || payment.paymentId || payment.utr || "Not available"],
        ["Currency", payment.currency || "INR"]
    ];
    let rowY = detailsTop + 39;
    detailRows.forEach(([label, value]) => {
        doc.fillColor(muted).font("Helvetica").fontSize(9).text(label, left, rowY, { width: 150 });
        doc.fillColor(ink).font("Helvetica-Bold").fontSize(9).text(String(value), left + 170, rowY, { width: contentWidth - 170, align: "right" });
        doc.moveTo(left, rowY + 21).lineTo(right, rowY + 21).strokeColor("#eeeeee").lineWidth(0.7).stroke();
        rowY += 32;
    });

    const amount = Number(payment.amount || 0);
    doc.roundedRect(left, rowY + 8, contentWidth, 64, 7).fill(ink);
    doc.fillColor("#ffffff").font("Helvetica-Bold").fontSize(11).text("TOTAL PAID", left + 18, rowY + 27);
    doc.fontSize(21).text(`${payment.currency || "INR"} ${amount.toFixed(2)}`, right - 220, rowY + 20, { width: 202, align: "right" });

    doc.fillColor(muted).font("Helvetica").fontSize(8)
        .text("This is a computer-generated receipt for a payment verified by the EngiLearn backend.", left, 744, { width: contentWidth, align: "center" })
        .text("Support: engilearn.edu@gmail.com", left, 760, { width: contentWidth, align: "center" });
    doc.end();
}

app.get("/api/payments/:id/receipt.pdf", requireAuth, (req, res) => {
    const db = readDb();
    const payment = (db.payments || []).find((item) => matchesPaymentKey(item, req.params.id));
    if (!payment) return res.status(404).json({ message: "Payment receipt was not found" });
    const ownsPayment = Number(payment.userId) === Number(req.currentUser.id)
        || String(payment.studentEmail || "").toLowerCase() === String(req.currentUser.email || "").toLowerCase();
    if (normalizeRole(req.currentUser.role) !== "Admin" && !ownsPayment) {
        return res.status(403).json({ message: "You can download only your own payment receipt" });
    }
    if (!isVerifiedPayment(payment)) {
        return res.status(409).json({ message: "A PDF receipt is generated only after payment is completed" });
    }
    const paymentUser = (db.users || []).find((user) => Number(user.id) === Number(payment.userId) || cleanEmail(user.email) === cleanEmail(payment.studentEmail));
    const receiptPayment = {
        ...payment,
        studentId: payment.studentId || paymentUser?.studentId || paymentUser?.engilearnId || paymentUser?.rollNumber,
        branch: payment.branch || payment.branchName || paymentUser?.branch,
        branchName: payment.branchName || payment.branch || paymentUser?.branch,
        semester: payment.semester || payment.unlockedSemester || paymentUser?.semester
    };
    res.setHeader("Content-Type", "application/pdf");
    res.setHeader("Content-Disposition", `attachment; filename="${receiptFileName(payment)}"`);
    res.setHeader("Cache-Control", "private, no-store");
    writePaymentReceiptPdf(res, receiptPayment);
});

function razorpayConfigured() {
    return Boolean(razorpayKeyId() && razorpayKeySecret());
}

function paymentProduct(req) {
    const product = String(req.body?.product || req.body?.type || "").trim().toLowerCase();
    if (["repeatedquestions", "repeated-questions"].includes(product)) {
        return {
            key: "repeatedQuestions",
            type: "Repeated Questions",
            description: "Most Repeated Questions Access",
            price: Math.max(1, Number(req.appSettings?.repeatedQuestions?.price || 100))
        };
    }
    if (["semesterpremium", "semester-premium", "premium"].includes(product)) {
        return {
            key: "semesterPremium",
            type: "Semester Premium",
            description: "Semester Premium Access",
            price: Math.max(1, Number(req.appSettings?.semesterPremium?.price || req.appSettings?.premium?.price || 100))
        };
    }
    return {
        key: "toolHub",
        type: "Tool Hub",
        description: "Tool Hub Access",
        price: Math.max(1, Number(req.body?.amount || req.body?.price || req.appSettings?.toolHub?.price || 100))
    };
}

function grantPaymentAccess(user, payment, verifiedAt, paymentId) {
    if (!user) return;
    const product = String(payment?.product || payment?.type || "").toLowerCase();
    if (product.includes("repeatedquestion")) {
        user.repeatedQuestionsAccess = true;
        user.repeatedQuestionsAccessGrantedAt = verifiedAt;
        user.repeatedQuestionsPaymentId = paymentId;
        return;
    }
    if (product.includes("semester")) {
        user.premium = true;
        user.isPremium = true;
        user.premiumAccess = true;
        user.semesterPremiumAccess = true;
        user.premiumAccessGrantedAt = verifiedAt;
        user.semesterPremiumPaymentId = paymentId;
        return;
    }
    user.toolHubAccess = true;
    user.toolHubAccessGrantedAt = user.toolHubAccessGrantedAt || verifiedAt;
    user.toolHubPaymentId = user.toolHubPaymentId || paymentId;
}

app.post("/api/toolhub/checkout/order", requireAuth, async (req, res) => {
    if (!razorpayConfigured()) {
        return res.status(503).json({ message: "Real payment gateway is not configured. Add Razorpay merchant keys in backend environment settings." });
    }
    const db = readDb();
    req.appSettings = db.settings || {};
    const product = paymentProduct(req);
    const price = product.price;
    const requestedSemester = paymentSemesterValue(req.body || {});
    const requestedBranch = String(req.body?.branchName || req.body?.branch || req.currentUser.branch || "").trim();
    const requestedSubject = String(req.body?.subjectName || req.body?.subject || "").trim();
    const receipt = `${product.key}_${Date.now()}`;
    try {
        const response = await fetch("https://api.razorpay.com/v1/orders", {
            method: "POST",
            headers: {
                Authorization: razorpayBasicAuthHeader(),
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ amount: Math.round(price * 100), currency: "INR", receipt, notes: { product: product.description, branch: requestedBranch, semester: requestedSemester } })
        });
        const order = await response.json();
        if (!response.ok || !order.id) throw new Error(order.error?.description || "Razorpay order creation failed");
        db.payments = [{
            id: nextId(db.payments || []),
            type: product.type,
            product: product.key,
            provider: "Razorpay",
            providerOrderId: order.id,
            receipt,
            slipNumber: receipt,
            userId: req.currentUser.id,
            studentName: String(req.currentUser.name || req.body.name || "Student").trim(),
            studentEmail: String(req.currentUser.email || req.body.email || "").trim().toLowerCase(),
            studentMobile: String(req.currentUser.mobile || req.currentUser.phone || req.body.mobile || "").trim(),
            studentId: String(req.currentUser.studentId || req.currentUser.engilearnId || req.currentUser.rollNumber || "").trim(),
            branch: requestedBranch,
            branchName: requestedBranch,
            semester: requestedSemester || String(req.currentUser.semester || "").replace(/\D+/g, ""),
            unlockedSemester: requestedSemester,
            subject: requestedSubject,
            amount: price,
            currency: "INR",
            status: "Created",
            createdAt: new Date().toISOString()
        }, ...(db.payments || [])].slice(0, 500);
        await writeDbAndWait(db);
    res.status(201).json({
            keyId: razorpayKeyId(),
            orderId: order.id,
            amount: order.amount,
            currency: order.currency,
            product: product.key,
            description: product.description,
            payeeName: db.settings?.toolHub?.payeeName || "EngiLearn"
        });
    } catch (error) {
        res.status(502).json({ message: normalizeRazorpayError(error, "Could not create secure payment order") });
    }
});

async function fetchRazorpayPayment(paymentId) {
    const response = await fetch(`https://api.razorpay.com/v1/payments/${encodeURIComponent(paymentId)}`, {
        method: "GET",
        headers: {
            Authorization: razorpayBasicAuthHeader()
        }
    });
    const payment = await response.json().catch(() => ({}));
    if (!response.ok) {
        throw new Error(normalizeRazorpayError({ message: payment.error?.description }, "Could not confirm payment with Razorpay"));
    }
    return payment;
}

app.post("/api/toolhub/checkout/verify", requireAuth, async (req, res) => {
    if (!razorpayConfigured()) return res.status(503).json({ message: "Real payment gateway is not configured" });
    const orderId = String(req.body.razorpay_order_id || "");
    const paymentId = String(req.body.razorpay_payment_id || "");
    const signature = String(req.body.razorpay_signature || "");
    const expected = crypto.createHmac("sha256", razorpayKeySecret()).update(`${orderId}|${paymentId}`).digest("hex");
    if (!orderId || !paymentId || !signature || !crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(signature.padEnd(expected.length).slice(0, expected.length)))) {
        return res.status(400).json({ message: "Payment signature verification failed", verified: false });
    }
    const db = readDb();
    const payment = (db.payments || []).find((item) => item.providerOrderId === orderId);
    if (!payment) return res.status(404).json({ message: "Payment order not found", verified: false });
    if (Number(payment.userId) !== Number(req.currentUser.id)) {
        return res.status(403).json({ message: "Payment order belongs to another account", verified: false });
    }
    let razorpayPayment;
    try {
        razorpayPayment = await fetchRazorpayPayment(paymentId);
    } catch (error) {
        return res.status(502).json({ message: error.message || "Payment could not be confirmed", verified: false });
    }
    if (String(razorpayPayment.order_id || "") !== orderId) {
        return res.status(400).json({ message: "Payment order mismatch", verified: false });
    }
    if (String(razorpayPayment.currency || "").toUpperCase() !== String(payment.currency || "INR").toUpperCase()) {
        return res.status(400).json({ message: "Payment currency mismatch", verified: false });
    }
    if (Number(razorpayPayment.amount || 0) < Math.round(Number(payment.amount || 0) * 100)) {
        return res.status(400).json({ message: "Payment amount mismatch", verified: false });
    }
    if (String(razorpayPayment.status || "").toLowerCase() !== "captured") {
        payment.status = `Gateway ${razorpayPayment.status || "Pending"}`;
        payment.providerPaymentId = paymentId;
        payment.gatewayStatus = razorpayPayment.status || "";
        writeDb(db);
        return res.status(409).json({ message: "Payment is not captured yet. Please wait and try again.", verified: false });
    }
    payment.status = "Paid";
    payment.providerPaymentId = paymentId;
    payment.gatewayStatus = razorpayPayment.status;
    payment.verifiedAt = new Date().toISOString();
    payment.slipSavedAt = payment.verifiedAt;
    payment.slipNumber = payment.slipNumber || payment.receipt || payment.providerOrderId;
    const user = db.users.find((item) => Number(item.id) === Number(req.currentUser.id));
    if (user) {
        grantPaymentAccess(user, payment, payment.verifiedAt, paymentId);
    }
    writeDb(db);
    res.json({
        message: String(payment.product || payment.type || "").toLowerCase().includes("repeatedquestion")
            ? "Payment verified. Most Repeated Questions unlocked."
            : String(payment.product || payment.type || "").toLowerCase().includes("semester")
                ? "Payment verified. Semester Premium unlocked."
                : "Payment verified. Tool Hub unlocked.",
        verified: true,
        paymentId,
        toolHubAccess: Boolean(user?.toolHubAccess),
        repeatedQuestionsAccess: Boolean(user?.repeatedQuestionsAccess),
        premiumAccess: Boolean(user?.premiumAccess || user?.semesterPremiumAccess),
        semesterPremiumAccess: Boolean(user?.semesterPremiumAccess),
        receiptKey: payment.id,
        receiptUrl: `/api/payments/${encodeURIComponent(payment.id)}/receipt.pdf`,
        user: user ? publicUser(user) : undefined
    });
});

