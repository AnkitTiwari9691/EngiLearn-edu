function persistDbToMongo(db) {
    if (!isMongoReady()) return;
    if (mongoWritePending) {
        mongoQueuedDb = db;
        return;
    }

    mongoWritePending = true;
    setTimeout(async () => {
        try {
            const dbToSave = mongoQueuedDb || db;
            mongoQueuedDb = null;
            await persistDbToMongoImmediate(dbToSave);
        } catch (error) {
            console.error("MongoDB save failed:", error.message);
        } finally {
            mongoWritePending = false;
            if (mongoQueuedDb) persistDbToMongo(mongoQueuedDb);
        }
    }, 0);
}

