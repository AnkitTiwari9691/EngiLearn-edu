        if (isTokenBlacklisted(db, token)) {
            writeDb(db);
            return res.status(401).json({ message: "Token has been logged out" });
        }
        req.auth = jwt.verify(token, JWT_SECRET);
        const user = db.users.find((item) => Number(item.id) === Number(req.auth.id));
        if (!user) {
            return res.status(401).json({ message: "Login account was not found" });
        }
        if (user.status === "Blocked") {
            return res.status(403).json({ message: "This account is blocked" });
        }
        req.currentUser = user;
        next();
    } catch (error) {
        res.status(401).json({ message: "Invalid or expired login" });
    }
}

