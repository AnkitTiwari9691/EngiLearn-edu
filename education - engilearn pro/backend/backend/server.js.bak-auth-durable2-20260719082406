function normalizeSmsRecipient(mobile) {
    const cleaned = cleanMobile(mobile);
    if (!cleaned) return "";
    if (cleaned.startsWith("+")) return cleaned;
    const digits = cleaned.replace(/\D/g, "");
    if (digits.length === 10) return `+91${digits}`;
    if (digits.length === 12 && digits.startsWith("91")) return `+${digits}`;
    return cleaned;
}

async function sendSmsOtp(user, otp) {
    const to = normalizeSmsRecipient(user.mobile);
    if (!to) {
        return { channel: "sms", skipped: true, sent: false, reason: "No mobile number on account" };
    }

    if (SMS_PROVIDER === "mock") {
        console.log(`[MOCK SMS OTP] ${user.otpPurpose || "otp"} for ${to}: ${otp}`);
        return { channel: "sms", provider: "mock", sent: true, to };
    }

    if (SMS_PROVIDER === "twilio") {
        if (!process.env.TWILIO_ACCOUNT_SID || !process.env.TWILIO_AUTH_TOKEN || !(process.env.TWILIO_FROM_NUMBER || process.env.TWILIO_PHONE_NUMBER)) {
            return { channel: "sms", provider: "twilio", skipped: true, sent: false, reason: "Twilio provider is not configured" };
        }

        const twilio = require("twilio")(process.env.TWILIO_ACCOUNT_SID, process.env.TWILIO_AUTH_TOKEN);
        await twilio.messages.create({
            body: `Your EngiLearn OTP is ${otp}. It expires in ${otpExpiresMinutes()} minutes.`,
            from: process.env.TWILIO_FROM_NUMBER || process.env.TWILIO_PHONE_NUMBER,
            to
        });
        return { channel: "sms", provider: "twilio", sent: true, to };
    }

    if (SMS_PROVIDER === "msg91") {
        if (!smsProviderConfigured()) {
            return { channel: "sms", provider: "msg91", skipped: true, sent: false, reason: "MSG91 provider is not configured" };
        }
        const mobile = to.replace(/\D/g, "");
        await postJson(`https://api.msg91.com/api/v5/otp?template_id=${encodeURIComponent(process.env.MSG91_TEMPLATE_ID)}&mobile=${encodeURIComponent(mobile)}&authkey=${encodeURIComponent(process.env.MSG91_AUTH_KEY)}`, {}, { otp });
        return { channel: "sms", provider: "msg91", sent: true, to };
    }

    if (SMS_PROVIDER === "fast2sms") {
        if (!smsProviderConfigured()) {
            return { channel: "sms", provider: "fast2sms", skipped: true, sent: false, reason: "Fast2SMS provider is not configured" };
        }
        const form = new URLSearchParams();
        form.set("route", process.env.FAST2SMS_ROUTE || "otp");
        form.set("variables_values", otp);
        form.set("numbers", to.replace(/\D/g, "").slice(-10));
        if (process.env.FAST2SMS_SENDER_ID) form.set("sender_id", process.env.FAST2SMS_SENDER_ID);
        await postForm("https://www.fast2sms.com/dev/bulkV2", {
            Authorization: process.env.FAST2SMS_API_KEY,
            "Content-Type": "application/x-www-form-urlencoded"
        }, form);
        return { channel: "sms", provider: "fast2sms", sent: true, to };
    }

    if (SMS_PROVIDER === "textlocal") {
        if (!smsProviderConfigured()) {
            return { channel: "sms", provider: "textlocal", skipped: true, sent: false, reason: "Textlocal provider is not configured" };
        }
        const form = new URLSearchParams();
        form.set("apikey", process.env.TEXTLOCAL_API_KEY);
        form.set("numbers", to.replace(/\D/g, ""));
        form.set("sender", process.env.TEXTLOCAL_SENDER || "TXTLCL");
        form.set("message", otpText(otp));
        await postForm("https://api.textlocal.in/send/", {
            "Content-Type": "application/x-www-form-urlencoded"
        }, form);
        return { channel: "sms", provider: "textlocal", sent: true, to };
    }

    return { channel: "sms", provider: SMS_PROVIDER, skipped: true, sent: false, reason: `Unsupported SMS provider: ${SMS_PROVIDER}` };
}

function otpResponseExtra(user, otp) {
