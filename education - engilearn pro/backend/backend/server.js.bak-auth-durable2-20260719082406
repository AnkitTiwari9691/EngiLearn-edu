async function setOtp(user, purpose, { incrementResend = false, preferredChannel = "both" } = {}) {
    const otp = generateOtp();
    user.otpHash = await bcrypt.hash(otp, 10);
    user.otpPurpose = purpose;
    const expiresMinutes = otpExpiresMinutes();
    user.otpExpiresAt = new Date(Date.now() + expiresMinutes * 60 * 1000).toISOString();
    user.otpAttempts = 0;
    user.otpResendCount = incrementResend ? Number(user.otpResendCount || 0) + 1 : 0;
    user.otpLastSentAt = new Date().toISOString();
    user.otpDelivery = {};
    const hasEmailRecipient = Boolean(cleanEmail(user?.email) && isValidEmail(cleanEmail(user.email)));
    const hasSmsRecipient = Boolean(normalizeSmsRecipient(user?.mobile));
    const smsOnlyAdmin = requiresTwilioAdminLogin(user) && preferredChannel === "sms";
    const sendEmail = preferredChannel === "both" || preferredChannel === "email" || (preferredChannel === "sms" && hasEmailRecipient);
    const sendSms = preferredChannel === "both" || preferredChannel === "sms" || (!smsOnlyAdmin && preferredChannel === "email" && !hasEmailRecipient && hasSmsRecipient);
    const deliveryTasks = [];
    if (sendEmail) {
        deliveryTasks.push((async () => {
            try {
                user.otpDelivery.email = await sendEmailOtp(user, otp, purpose);
            } catch (error) {
                user.otpDelivery.email = { channel: "email", sent: false, error: error.message };
                console.error("Email OTP failed:", error.message);
            }
        })());
    }
    if (sendSms) {
        deliveryTasks.push((async () => {
            try {
                user.otpDelivery.sms = await sendSmsOtp(user, otp);
            } catch (error) {
                const trialBlocked = /unverified|Trial accounts/i.test(error.message || "");
                if (trialBlocked && process.env.NODE_ENV !== "production") {
                    const to = normalizeSmsRecipient(user.mobile);
                    console.log(`[MOCK SMS OTP FALLBACK] ${purpose} for ${to || user.mobile || "mobile"}: ${otp}`);
                    user.otpDelivery.sms = {
                        channel: "sms",
                        provider: "mock",
                        sent: true,
                        to,
                        fallbackReason: "Twilio trial blocked this unverified number; mock SMS used for local testing."
                    };
                } else {
                    user.otpDelivery.sms = { channel: "sms", sent: false, error: error.message };
                    console.error("SMS OTP failed:", error.message);
                }
            }
        })());
    }
    const otpDeliveryTimeoutMs = Number.isFinite(Number(process.env.OTP_DELIVERY_TIMEOUT_MS)) ? Number(process.env.OTP_DELIVERY_TIMEOUT_MS) : 6500;
    await Promise.race([
        Promise.all(deliveryTasks),
        new Promise((resolve) => setTimeout(resolve, Math.max(3000, otpDeliveryTimeoutMs)))
    ]);
    return otp;
}

