                pendingSignup: true,
                action: "complete_signup"
            });
        }
        return res.status(404).json({ message: "Account not found" });
    }
    if (!ensureAccountApprovalAllowed(db, user)) return res.status(403).json({ message: "Your account is waiting for admin approval" });
    if (user.status === "Blocked") return res.status(403).json({ message: "This account is blocked" });
    const twilioAdminLogin = requiresTwilioAdminLogin(user);
    if (twilioAdminLogin && (SMS_PROVIDER !== "twilio" || !smsProviderConfigured())) {
        return res.status(503).json({
            code: "TWILIO_SMS_REQUIRED",
            message: "Twilio SMS OTP is required for Academic Admin and Content Admin login, but Twilio is not configured."
        });
    }
    if (twilioAdminLogin && !isValidMobile(normalizeSmsRecipient(user.mobile))) {
        return res.status(400).json({
            code: "ADMIN_MOBILE_REQUIRED",
            message: "A valid registered mobile number is required for this admin account."
        });
    }
    resetExpiredOtpWindow(user);
    const waitSeconds = otpCooldownSeconds(user);
    if (waitSeconds > 0) {
        await writeDbAndWait(db);
        return otpCooldownResponse(res, user);
    }

    if (isResend && Number(user.otpResendCount || 0) >= OTP_MAX_RESENDS) return res.status(429).json({ message: "OTP resend limit reached" });

    const adminEmailOtp = normalizeRole(user.role) === "Admin" && isValidEmail(cleanEmail(user.email));
    const preferredChannel = twilioAdminLogin && !adminEmailOtp ? "sms" : adminEmailOtp ? "email" : identifierOtpChannel(identifier);
    const otp = await setOtp(user, "login", { incrementResend: isResend, preferredChannel });
    const sentEmailOtp = Boolean(user.otpDelivery?.email?.sent);
    const sentSmsOtp = Boolean(user.otpDelivery?.sms?.sent);
    const deliverySucceeded = twilioAdminLogin && !adminEmailOtp
        ? sentSmsOtp && user.otpDelivery?.sms?.provider === "twilio"
        : otpDeliveryOk(user);
    if (!deliverySucceeded) {
        const body = otpDeliveryFailedBody(user);
        clearOtp(user);
        await writeDbAndWait(db);
        return res.status(502).json(body);
    }

    await writeDbAndWait(db);
    res.json({
        message: twilioAdminLogin
            ? (twilioAdminLogin && !adminEmailOtp ? "Twilio SMS login OTP sent to your registered mobile number." : "Admin login OTP sent to your registered email address.")
            : sentEmailOtp
            ? "Login OTP sent to your registered email address."
            : sentSmsOtp
            ? "Login OTP sent to your registered mobile number."
            : "Login OTP sent to your registered email or mobile.",
        expiresInMinutes: otpExpiresMinutes(),
        ...otpResponseExtra(user, otp)
    });
});

