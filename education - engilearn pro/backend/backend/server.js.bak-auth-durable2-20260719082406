function hasPyqLibrary(candidate) {
    return Boolean(candidate)
        && fs.existsSync(candidate)
        && (fs.existsSync(path.join(candidate, "pyq-index.csv")) || fs.existsSync(path.join(candidate, "all-files")));
}

function discoverPyqLibraryDir(configuredPath) {
    const candidates = [
        configuredPath,
        path.join(FRONTEND_DIR, "pyq-files"),
        path.join(process.cwd(), "btech-all-branches-pyq")
    ].filter(Boolean);
    const oneDriveRoot = path.join(os.homedir(), "OneDrive");
    if (fs.existsSync(oneDriveRoot)) {
        candidates.push(path.join(oneDriveRoot, "New project", "btech-all-branches-pyq"));
        try {
            for (const entry of fs.readdirSync(oneDriveRoot, { withFileTypes: true })) {
                if (entry.isDirectory()) {
                    candidates.push(path.join(oneDriveRoot, entry.name, "New project", "btech-all-branches-pyq"));
                }
            }
        } catch (error) {
            // Ignore discovery errors; the configured path or frontend fallback may still be valid.
        }
    }
    const existing = candidates.map((candidate) => path.resolve(candidate)).find(hasPyqLibrary);
    return existing || path.resolve(configuredPath || path.join(FRONTEND_DIR, "pyq-files"));
}

