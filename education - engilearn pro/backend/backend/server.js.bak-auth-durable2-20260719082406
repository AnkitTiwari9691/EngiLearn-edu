}

function mobileIdentifierKeys(value) {
    const cleaned = cleanMobile(value);
    const digits = cleaned.replace(/\D/g, "");
    const keys = new Set();
    if (cleaned) keys.add(cleaned.toLowerCase());
    if (digits) keys.add(digits);
    if (digits.length > 10) keys.add(digits.slice(-10));
    if (digits.length === 10) {
        keys.add(`91${digits}`);
        keys.add(`+91${digits}`);
    }
    return keys;
}

function identifierKeys(value) {
    const raw = String(value || "").trim();
    const keys = new Set();
    if (!raw) return keys;
    keys.add(raw.toLowerCase());
    const email = cleanEmail(raw);
    if (email && email.includes("@")) keys.add(email);
    mobileIdentifierKeys(raw).forEach((key) => keys.add(key));
    return keys;
}

function userIdentifierKeys(user) {
    const keys = new Set();
    const identityValues = [
        user.email,
        user.emailAddress,
        user.alternateEmail,
        user.username,
        user.loginId,
        user.userId,
        user.accountId,
        user.identifier,
        user.primaryIdentifier,
        user.authIdentifier,
        user.emailOrMobile,
        user.loginIdentifier,
        user.registrationId,
        user.rollNumber,
        user.studentId,
        user.engilearnId,
        user.adminId,
        user.teacherId
    ];
    if (Array.isArray(user.authIdentifiers)) identityValues.push(...user.authIdentifiers);
    if (Array.isArray(user.identifiers)) identityValues.push(...user.identifiers);
    identityValues.filter(Boolean).forEach((value) => {
        identifierKeys(value).forEach((key) => keys.add(key));
    });

    const mobileValues = [
        user.mobile,
        user.phone,
        user.mobileNumber,
        user.phoneNumber,
        user.mobileNo,
        user.phoneNo,
        user.contact,
        user.contactNumber,
        user.contactMobile,
        user.contactPhone,
        user.whatsapp,
        user.whatsApp,
        user.guardianMobile,
        user.guardianPhone,
        user.parentMobile,
        user.parentPhone
    ];
    mobileValues.filter(Boolean).forEach((value) => {
        mobileIdentifierKeys(value).forEach((key) => keys.add(key));
    });
    return keys;
}
function userMatchesIdentifier(user, identifier) {
    const requested = identifierKeys(identifier);
    if (!requested.size) return false;
    const available = userIdentifierKeys(user);
    return [...requested].some((key) => available.has(key));
}

