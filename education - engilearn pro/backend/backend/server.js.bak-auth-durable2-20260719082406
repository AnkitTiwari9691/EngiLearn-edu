function passwordSetupHash() {
    return bcrypt.hashSync(`setup-required-${crypto.randomUUID()}`, 10);
}

function hasKnownPresetPassword(user, knownPasswords) {
    const hash = user?.passwordHash || "";
    if (!hash) return true;
    return knownPasswords.some((password) => {
        try {
            return bcrypt.compareSync(String(password), hash);
        } catch (error) {
            return false;
        }
    });
}

function requireOwnPassword(user, reason = "Create your own password with OTP before login") {
    user.passwordHash = passwordSetupHash();
    delete user.password;
    delete user.passwordUpdatedAt;
    user.mustSetPassword = true;
    user.ownPasswordCreated = false;
    user.passwordCreated = false;
    user.isPasswordSet = false;
    user.hasPassword = false;
    user.firstLogin = true;
    user.passwordSetupRequiredAt = user.passwordSetupRequiredAt || new Date().toISOString();
    user.activity = reason;
    user.loginAttempts = 0;
    user.failedLoginAttempts = 0;
    delete user.lockUntil;
    delete user.refreshTokenHash;
    clearOtp(user);
    return user;
}

function markPasswordCreated(user, reason = "Password created") {
    if (!user) return user;
    delete user.password;
    delete user.resetPasswordHash;
    delete user.resetPasswordExpires;
    delete user.passwordResetVerified;
    delete user.mustSetPassword;
    delete user.passwordSetupRequiredAt;
    user.ownPasswordCreated = true;
    user.passwordCreated = true;
    user.isPasswordSet = true;
    user.hasPassword = true;
    user.firstLogin = false;
    user.passwordUpdatedAt = new Date().toISOString();
    user.activity = reason;
    return user;
}

function passwordStateSummary(user) {
    return {
        id: user?.id || "",
        role: user?.role || "",
        identifier: user?.email || user?.mobile || user?.phone || "",
        mustSetPassword: Boolean(user?.mustSetPassword),
        ownPasswordCreated: Boolean(user?.ownPasswordCreated),
        passwordCreated: Boolean(user?.passwordCreated),
        isPasswordSet: Boolean(user?.isPasswordSet),
        hasPassword: Boolean(user?.hasPassword),
        firstLogin: Boolean(user?.firstLogin),
        hasHash: Boolean(user?.passwordHash)
    };
}

function hasCompletedPasswordCredential(user) {
    return Boolean(user?.passwordHash && !user.mustSetPassword && (
        user.passwordUpdatedAt
        || user.ownPasswordCreated
        || user.passwordCreated
        || user.isPasswordSet
        || user.hasPassword
        || user.firstLogin === false
    ));
}

function hasIncompletePasswordState(user) {
    if (!user) return false;
    if (hasCompletedPasswordCredential(user)) return false;
    return Boolean(
        user.mustSetPassword
        || !user.ownPasswordCreated
        || !user.passwordCreated
